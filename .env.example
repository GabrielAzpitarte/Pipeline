# Copy this to .env and fill in real values.
# Never commit .env itself.

# Paths
DATA_RAW_DIR=./data_raw
DATA_PROCESSED_DIR=./data_processed
ARTIFACTS_DIR=./artifacts

# Logging
LOG_LEVEL=INFO

# Simulation defaults
SIM_INITIAL_CASH=0
SIM_POSITION_LIMIT=20
SIM_TIME_LIMIT=1000000

# API keys for the orchestrator (Phase 9)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AI...
